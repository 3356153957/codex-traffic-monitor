<Window x:Class="CodexTraffic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTraffic"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Codex 流量统计" Width="1360" Height="940" MinWidth="1100" MinHeight="820"
        Icon="Assets/app.ico" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="#18232D" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="39" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Assets/Icons.xaml" /></ResourceDictionary.MergedDictionaries>
        <Thickness x:Key="RankingRowMargin">0,3,0,3</Thickness>
        <SolidColorBrush x:Key="Muted" Color="#667B8B" />
        <Style x:Key="NumericText" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="FontFamily" Value="Segoe UI" /></Style>
        <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFB" /><Setter Property="Foreground" Value="#667B8B" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#E9EDF1" /><Setter Property="Padding" Value="14,0" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#263340" />
            <Setter Property="BorderBrush" Value="#DCE2E8" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4288DC" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionBorder" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                        <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:ButtonIcon.Data)}" Width="14" Height="14" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,7,0" IsHitTestVisible="False" />
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionBorder" Property="BorderBrush" Value="#4288DC" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionBorder" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#516674" /><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" /><Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionButtonBorder" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionButtonBorder" Property="Background" Value="#E4EAF0" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionButtonBorder" Property="Background" Value="#D6E0E8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CloseButtonBorder" Background="{TemplateBinding Background}"><Path x:Name="CloseSymbol" Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseButtonBorder" Property="Background" Value="#D94B50" /><Setter TargetName="CloseSymbol" Property="Stroke" Value="White" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseButtonBorder" Property="Background" Value="#BE343B" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RangeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="14,6" /><Setter Property="Foreground" Value="#667888" /></Style>
        <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="#566371" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E4E8ED" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F2F5" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="RowHeight" Value="46" /><Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="CanUserResizeRows" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFB" /><Setter Property="Foreground" Value="#7B8793" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#E9EDF1" /><Setter Property="Padding" Value="18,0" /></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="18,0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FB" /><Setter Property="Foreground" Value="#18232D" /></Trigger></Style.Triggers></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#7B8793" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="0,14,0,13" Margin="0,0,28,0" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#1B2835" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TabControl"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="White" /><Setter Property="Padding" Value="0" /></Style>
    </ResourceDictionary></Window.Resources>
    <Window.Template><ControlTemplate TargetType="Window">
        <Border x:Name="WindowFrame" Background="{TemplateBinding Background}" BorderBrush="#CCD6DF" BorderThickness="1" CornerRadius="8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="39" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="CaptionBar" Background="#F4F6F8" BorderBrush="#E4EAF0" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" MouseRightButtonUp="CaptionBar_MouseRightButtonUp">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Image Source="{StaticResource AppMark}" Width="20" Height="20" Margin="0,0,9,0" /><TextBlock Text="{TemplateBinding Title}" Foreground="#526875" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CaptionMinimizeButton" Style="{StaticResource CaptionButton}" Click="CaptionMinimize_Click" ToolTip="最小化到托盘" AutomationProperties.Name="最小化到托盘"><Path Data="M 0,6 L 10,6" Width="10" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" /></Button>
                            <Button x:Name="CaptionMaximizeButton" Style="{StaticResource CaptionButton}" Click="CaptionMaximize_Click" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"><Path x:Name="MaximizeSymbol" Data="M 1,1 L 11,1 L 11,11 L 1,11 Z" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" /></Button>
                            <Button x:Name="CaptionCloseButton" Style="{StaticResource CaptionCloseButton}" Click="CaptionClose_Click" ToolTip="收起到托盘，继续记录" AutomationProperties.Name="收起到托盘" />
                        </StackPanel>
                    </Grid>
                </Border>
                <AdornerDecorator Grid.Row="1"><ContentPresenter Content="{TemplateBinding Content}" /></AdornerDecorator>
            </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter TargetName="WindowFrame" Property="CornerRadius" Value="0" /><Setter TargetName="CaptionBar" Property="CornerRadius" Value="0" /><Setter TargetName="MaximizeSymbol" Property="Data" Value="M 4,1 L 11,1 L 11,8 M 1,4 L 8,4 L 8,11 L 1,11 Z" /></Trigger><Trigger Property="IsActive" Value="False"><Setter TargetName="WindowFrame" Property="BorderBrush" Value="#E0E5EA" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Window.Template>
    <Grid Margin="28,20,28,14">
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="42" /><RowDefinition Height="124" /><RowDefinition Height="212" /><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="40" Height="40" Background="#172838" CornerRadius="10" Margin="0,3,13,0"><Canvas Width="23" Height="23"><Path Stroke="#C5F1DF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,15 L 3,8 M 9,19 L 9,4 M 15,15 L 15,8 M 21,17 L 21,6" /></Canvas></Border>
                <StackPanel><TextBlock Text="Codex 流量统计" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="本机记录 · 历史持续累计" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
                <Border x:Name="StatusPill" CornerRadius="11" Background="#EAF0F5" VerticalAlignment="Top" Margin="17,10,0,0" Padding="9,4"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#94A3B8" Width="6" Height="6" Margin="0,0,6,0" /><TextBlock x:Name="StatusText" Text="准备就绪" FontSize="11" Foreground="#657486" /></StackPanel></Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
                <Button x:Name="AdminButton" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconShield}" Click="AdminButton_Click" Content="管理员启动" Margin="0,0,10,0" ToolTip="通过 Windows UAC 以管理员身份重新启动，以记录每个进程的上下行字节数" />
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconSettings}" Click="SettingsButton_Click" Content="监控设置" Margin="0,0,10,0" />
                <Button x:Name="StartButton" Click="StartButton_Click" Background="#1B2A38" Foreground="White" BorderBrush="#1B2A38" MinWidth="112"><StackPanel Orientation="Horizontal"><Path x:Name="StartIcon" Fill="White" Width="9" Height="10" Stretch="Uniform" Data="M 0,0 L 9,5 L 0,10 Z" Margin="0,0,8,0" /><TextBlock x:Name="StartButtonText" Text="开始监控" /></StackPanel></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Border Background="#E7EDF2" CornerRadius="7" Padding="3"><StackPanel Orientation="Horizontal"><Button x:Name="RangeAllButton" Style="{StaticResource RangeButton}" Content="全部记录" Tag="3" Click="RangeButton_Click" /><Button x:Name="RangeTodayButton" Style="{StaticResource RangeButton}" Content="今日" Tag="0" Click="RangeButton_Click" /><Button x:Name="RangeWeekButton" Style="{StaticResource RangeButton}" Content="近 7 天" Tag="1" Click="RangeButton_Click" /><Button x:Name="RangeMonthButton" Style="{StaticResource RangeButton}" Content="近 30 天" Tag="2" Click="RangeButton_Click" /></StackPanel></Border>
                <ComboBox x:Name="RangeCombo" Visibility="Collapsed" SelectedIndex="3" SelectionChanged="RangeCombo_SelectionChanged" AutomationProperties.Name="统计时间范围"><ComboBoxItem Content="今日" /><ComboBoxItem Content="近 7 天" /><ComboBoxItem Content="近 30 天" /><ComboBoxItem Content="全部记录" /></ComboBox>
                <TextBlock x:Name="ScopeText" Text="从首次记录至今" Foreground="#7B8793" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="#E7EDF2" CornerRadius="7" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="TrafficAllButton" Style="{StaticResource RangeButton}" Content="全部流量" Tag="All" Click="TrafficScopeButton_Click" AutomationProperties.Name="统计全部流量" /><Button x:Name="TrafficProxyButton" Style="{StaticResource RangeButton}" Content="已确认代理" Tag="Proxy" Click="TrafficScopeButton_Click" AutomationProperties.Name="仅统计已确认代理流量" ToolTip="只统计记录时取得节点或代理类型证据的流量。未知未取得足够代理报告，不等于直连。" /></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="1.05*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#192C3B" CornerRadius="10" Padding="20,12" Margin="0,0,14,0"><Grid><StackPanel><TextBlock x:Name="TotalTitleText" Text="累计总流量" Foreground="#C0CBD4" FontSize="12" /><TextBlock x:Name="TotalText" Text="0 B" FontSize="34" FontWeight="SemiBold" Foreground="White" Margin="0,7,0,0" /><TextBlock x:Name="TotalHintText" Text="上行 + 下行 · 从首次记录累计" Foreground="#A7BAC8" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><Path Data="{StaticResource IconTransfer}" Stroke="#7C9AAE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" /></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,14,0"><StackPanel><TextBlock Text="↑ 上行流量" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="UploadTotalText" Text="0 B" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock x:Name="UploadShareText" Text="发送至目标的流量" Foreground="#168F6A" FontSize="11" Margin="0,6,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,14,0"><StackPanel><TextBlock Text="↓ 下行流量" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="DownloadTotalText" Text="0 B" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock x:Name="DownloadShareText" Text="从目标接收的流量" Foreground="#3479CE" FontSize="11" Margin="0,6,0,0" /></StackPanel></Border>
            <Border x:Name="TrafficComparisonCard" Grid.Column="3" Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock x:Name="ComparisonTitleText" Text="其中 · 已确认代理" Foreground="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="ComparisonTotalText" Text="0 B" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock x:Name="ProxyShareText" Text="代理占全部 0.0%" Foreground="#426B90" FontSize="11" Margin="0,6,0,0" /><Grid Height="4" Margin="0,8,0,0" Background="#EAF0F5"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ProxyFractionColumn" Width="0*" /><ColumnDefinition x:Name="RemainingFractionColumn" Width="*" /></Grid.ColumnDefinitions><Border Background="#4A91CA" CornerRadius="2" /></Grid></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,12,18,7" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="19" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconChart}" Stroke="#667B8B" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="每日流量" FontWeight="SemiBold" FontSize="14" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"><Rectangle Width="7" Height="7" Fill="#1AA77A" Margin="0,0,6,0" /><TextBlock Text="上行" FontSize="11" Foreground="#778594" Margin="0,0,17,0" /><Rectangle Width="7" Height="7" Fill="#4288DC" Margin="0,0,6,0" /><TextBlock Text="下行" FontSize="11" Foreground="#778594" /></StackPanel>
                <TextBlock x:Name="DailyRangeText" Grid.Row="1" Text="当前范围内最近 30 天 · 按本地日期" Foreground="#909BA6" FontSize="10" />
                <local:DailyUsageChart x:Name="DailyChart" Grid.Row="2" />
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,12"><Grid><Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRanking}" Stroke="#667B8B" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="流量去向排行" FontWeight="SemiBold" FontSize="14" /></StackPanel><TextBlock Text="前 5 名 · 点击筛选" Foreground="#909BA6" FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0" />
                <ItemsControl x:Name="RankingList" Grid.Row="1"><ItemsControl.ItemTemplate><DataTemplate><Button Click="RankingItem_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="{DynamicResource RankingRowMargin}" ToolTip="{Binding Details}"><Grid><Grid.RowDefinitions><RowDefinition Height="19" /><RowDefinition Height="4" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" Foreground="#91A2B0" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Foreground="#435B6D" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Display}" Foreground="#435B6D" FontSize="11" /><Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#EDF2F6"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding UsedWidth}" /><ColumnDefinition Width="{Binding RemainingWidth}" /></Grid.ColumnDefinitions><Border Background="#78A9D9" CornerRadius="2" /></Grid></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock x:Name="RankingEmptyText" Grid.Row="1" Text="开始记录后显示流量去向" FontSize="11" Foreground="#A3ACB5" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid></Border>
        </Grid>
        <Grid Grid.Row="4" Margin="1,0,0,7">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="实时 · 全部流量" FontSize="11" Foreground="#84919D" Margin="0,0,14,0" /><TextBlock x:Name="UploadRateText" Text="↑ 0 B/s" Foreground="#168F6A" FontSize="12" Margin="0,0,20,0" /><TextBlock x:Name="DownloadRateText" Text="↓ 0 B/s" Foreground="#3479CE" FontSize="12" Margin="0,0,20,0" /><TextBlock x:Name="ProcessHintText" Text="0 个 Codex 进程 · 0 个连接" FontSize="11" Foreground="#84919D" /></StackPanel><TextBlock x:Name="OptionsSummaryText" Text="派生工具已计入" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-230" VerticalOffset="8"><Border Style="{StaticResource Card}" Padding="20" Width="330"><StackPanel>
                <TextBlock Text="监控设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16" />
                <CheckBox x:Name="StartupCheck" Content="开机自动监控" IsEnabled="False" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" />
                <TextBlock Text="登录 Windows 后在托盘后台记录" Foreground="{StaticResource Muted}" FontSize="11" Margin="20,5,0,16" />
                <Border BorderBrush="#E9EDF1" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel><TextBlock Text="采集范围" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                <CheckBox x:Name="ChildrenCheck" Content="包含派生工具进程" Checked="Options_Changed" Unchecked="Options_Changed" /><TextBlock Text="由 Codex 启动的 shell、Python、Node 等" FontSize="11" Foreground="{StaticResource Muted}" Margin="20,5,0,13" />
                <CheckBox x:Name="LoopbackCheck" Content="计入本机连接" Checked="Options_Changed" Unchecked="Options_Changed" ToolTip="包含本机回环与代理连接；本机内部连接可能在双方各记录一次" /><TextBlock Text="含本机代理连接；内部通信可能两端计数" FontSize="11" Foreground="{StaticResource Muted}" Margin="20,5,0,12" />
                <TextBlock x:Name="SettingsHintText" Text="暂停监控后可修改采集范围" Foreground="#8A7050" FontSize="11" TextWrapping="Wrap" /></StackPanel></Border>
                <Border BorderBrush="#E9EDF1" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,13,0,0"><Button x:Name="ExitButton" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconPower}" Content="退出程序" Click="ExitButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,6" BorderThickness="0" Background="Transparent" Foreground="#657786" ToolTip="保存当前记录并退出，后台采集将停止" /></Border>
            </StackPanel></Border></Popup>
        </Grid>
        <Border Grid.Row="5" Style="{StaticResource Card}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="28" /></Grid.RowDefinitions>
            <Grid Margin="20,0"><StackPanel Orientation="Horizontal"><Button x:Name="TargetsTab" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconGlobe}" Click="TargetsTab_Click" Padding="0,12" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,25,0"><TextBlock x:Name="TargetsTabText" Text="累计去向" TextDecorations="Underline" /></Button><Button x:Name="ProcessesTab" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconProcess}" Click="ProcessesTab_Click" Padding="0,12" Background="Transparent" BorderThickness="0" Foreground="#84909B" Margin="0,0,25,0" ><TextBlock x:Name="ProcessesTabText" Text="当前进程" /></Button><Button x:Name="SessionsTab" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconHistory}" Click="SessionsTab_Click" Padding="0,12" Background="Transparent" BorderThickness="0" Foreground="#84909B" ><TextBlock x:Name="SessionsTabText" Text="历史会话" /></Button></StackPanel><Border x:Name="SearchBorder" BorderBrush="#E0E6EC" BorderThickness="1" CornerRadius="5" Width="280" Height="29" HorizontalAlignment="Right" VerticalAlignment="Center"><Grid><TextBox x:Name="TargetSearchBox" BorderThickness="0" Background="Transparent" Padding="29,5,30,5" FontSize="11" TextChanged="TargetSearchBox_TextChanged" AutomationProperties.Name="搜索域名、IP、地区或节点" /><TextBlock x:Name="SearchPlaceholder" Text="搜索域名、IP、地区或节点" Foreground="#9AA5AF" IsHitTestVisible="False" Margin="29,0,0,0" VerticalAlignment="Center" FontSize="11" /><Path Data="{StaticResource IconSearch}" Stroke="#91A0AD" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" /><Button x:Name="ClearSearchButton" Click="ClearSearchButton_Click" Content="×" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8,2" HorizontalAlignment="Right" FontSize="15" ToolTip="清除搜索" AutomationProperties.Name="清除搜索" /></Grid></Border></Grid>
            <Grid Grid.Row="1"><DataGrid x:Name="TargetsGrid" Sorting="DataGrid_Sorting" SelectionChanged="TargetsGrid_SelectionChanged"><DataGrid.Columns>
                <DataGridTemplateColumn Header="目标 / 进程" SortMemberPath="Target" Width="2.25*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Details}"><TextBlock Text="{Binding Target}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Process}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="目标地区 / 路径" SortMemberPath="Region" Width="1.25*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Details}"><TextBlock Text="{Binding Region}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Route}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="代理节点" SortMemberPath="ProxyNode" Width="1.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Details}"><TextBlock Text="{Binding ProxyNode}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ProxyContext}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="↑ 上行" Binding="{Binding UploadDisplay}" SortMemberPath="UploadBytes" Width="0.8*" HeaderStyle="{StaticResource NumericHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}"><Setter Property="Foreground" Value="#168F6A" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="↓ 下行" Binding="{Binding DownloadDisplay}" SortMemberPath="DownloadBytes" Width="0.8*" HeaderStyle="{StaticResource NumericHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}"><Setter Property="Foreground" Value="#3479CE" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="合计" Binding="{Binding TotalDisplay}" SortMemberPath="TotalBytes" Width="0.8*" HeaderStyle="{StaticResource NumericHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}"><Setter Property="FontWeight" Value="SemiBold" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            </DataGrid.Columns></DataGrid>
            <DataGrid x:Name="ProcessesGrid" Visibility="Collapsed" Sorting="DataGrid_Sorting"><DataGrid.Columns><DataGridTextColumn Header="当前进程" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="0.7*" /><DataGridTextColumn Header="进程类型" Binding="{Binding Kind}" Width="1.4*" /><DataGridTextColumn Header="本次 ↑ 上行" Binding="{Binding UploadDisplay}" SortMemberPath="UploadBytes" Width="1*" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericText}" /><DataGridTextColumn Header="本次 ↓ 下行" Binding="{Binding DownloadDisplay}" SortMemberPath="DownloadBytes" Width="1*" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericText}" /></DataGrid.Columns></DataGrid>
            <DataGrid x:Name="SessionsGrid" Visibility="Collapsed" Sorting="DataGrid_Sorting"><DataGrid.Columns><DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="2*" /><DataGridTextColumn Header="持续时间" Binding="{Binding Duration}" Width="1.2*" /><DataGridTextColumn Header="↑ 上行" Binding="{Binding UploadDisplay}" SortMemberPath="UploadBytes" Width="1*" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericText}" /><DataGridTextColumn Header="↓ 下行" Binding="{Binding DownloadDisplay}" SortMemberPath="DownloadBytes" Width="1*" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericText}" /><DataGridTextColumn Header="总流量" Binding="{Binding TotalDisplay}" SortMemberPath="TotalBytes" Width="1*" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericText}" /></DataGrid.Columns></DataGrid>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10"><TextBlock x:Name="EmptyTitle" Text="还没有流量记录" FontSize="14" Foreground="#75818D" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyHint" Text="开始监控后，用量会保存在本机，重启后继续累计" FontSize="11" Foreground="#A3ACB5" Margin="0,8,0,0" /></StackPanel></Grid>
            <Border x:Name="TargetDetailBorder" Grid.Row="2" Visibility="Collapsed" Background="#F3F8FD" BorderBrush="#DFEAF4" BorderThickness="0,1,0,0" Padding="16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DetailTitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" /><ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"><TextBox x:Name="DetailBodyText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" Foreground="#435D70" FontSize="11" /></ScrollViewer></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,0,0,0"><Button x:Name="CopyDetailButton" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconCopy}" Click="CopyDetailButton_Click" Content="复制详情" Padding="10,5" FontSize="11" /><Button Click="CloseDetailButton_Click" Content="×" Background="Transparent" BorderThickness="0" Padding="8,1" FontSize="18" ToolTip="收起详情" /></StackPanel></Grid></Border>
            <Border Grid.Row="3" BorderBrush="#EEF1F4" BorderThickness="0,1,0,0" Padding="20,0"><Grid><TextBlock x:Name="TableHintText" Text="当前范围累计 · 按总流量排序" Foreground="#939EA9" FontSize="10" VerticalAlignment="Center" /><TextBlock x:Name="TargetCountText" Text="0 个目标" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#939EA9" FontSize="10" /></Grid></Border>
        </Grid></Border>
        <Grid Grid.Row="6" Margin="0,9,0,0"><StackPanel VerticalAlignment="Center" Margin="0,0,370,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="CaptureDot" Fill="#9AA7B5" Width="5" Height="5" Margin="0,0,7,0" /><TextBlock x:Name="CaptureHintText" MaxWidth="390" Text="记录保存在本机" Foreground="#8A95A1" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SessionTimeText" MaxWidth="200" TextTrimming="CharacterEllipsis" Foreground="#8A95A1" FontSize="10" Margin="12,0,0,0" /></StackPanel><TextBlock x:Name="WarningText" Text="" Foreground="#7B817E" FontSize="9" Margin="12,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="OpenDataButton" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconFolder}" Click="OpenDataButton_Click" Content="打开数据目录" Padding="10,6" Background="Transparent" BorderThickness="0" Foreground="#718194" FontSize="11" Margin="0,0,8,0" /><Button x:Name="ExportButton" Style="{StaticResource IconButton}" local:ButtonIcon.Data="{StaticResource IconExport}" Click="ExportButton_Click" Content="导出当前范围 CSV" Padding="12,6" FontSize="11" /></StackPanel></Grid>
    </Grid>
</Window>
